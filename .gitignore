# =============================================================================
# PRIVACY BOUNDARY
# ADNI, OASIS-3, and AIBL data are governed/restricted and must not be committed.
# This file intentionally favors preventing disclosure over repository convenience.
# =============================================================================

# Restricted source datasets and generated participant-level data
[Dd]atasets/
[Pp]rocessed[Dd]ata/
processed_data/
derived_data/
intermediate_data/
LiteratureAndPlan

# Reports, result tables, evidence synthesis, and fitted artifacts
# These may contain row-level values, predictions, paths, or restricted metadata.
[Rr]eports/
[Rr]esults/*
[Mm]odels/
evidenceBOOK/
artifacts/
outputs/

# Reviewed aggregate figures are safe to publish. Result tables remain ignored.
!/results/plots/

# These Phase 3 trajectory exports disclose actual ADNI participant numbers.
/results/plots/phase3/dynamic_risk_trajectories.png
/results/plots/phase3/dynamic_risk_trajectories.svg

# Result-bearing synthesis documents outside the reports directory
/LiteratureAndPlan/Plan.md
/LiteratureAndPlan/Complete_Project_Results_Synthesis.md
**/demographics_report*.md

# Notebooks with saved participant identifiers or participant-level table previews.
# Aggregate-only notebooks are intentionally allowed for reproducible reporting.
/notebooks/DataExploration/adni/01_adni_demographics.ipynb
/notebooks/DataExploration/aibl/03_aibl_demographics.ipynb
/notebooks/DataExploration/oasis3/02_oasis3_demographics.ipynb
/notebooks/Phase1/Phase1_DataFoundationAndEndpointValidation.ipynb
/notebooks/Phase2/Phase2_LandmarksMissingnessAndHarmonization.ipynb
/notebooks/Phase3/Phase3_ADNIModelDevelopmentAndInternalValidation.ipynb
/notebooks/Phase5/Phase5_SecondaryAnalysesAndFinalReporting.ipynb
.ipynb_checkpoints/
**/.ipynb_checkpoints/

